allow keystore {adb_data_file shell_data_file} file *
allow crash_dump keystore process *

# SOTER Layer-A (10.C): ptrace inject into soterserver (platform_app). The debug NDJSON
# media_rw_data_file grant is debug-only — appended for debug builds in app/build.gradle.kts.
allow crash_dump platform_app process *

# KernelSU Next only: both bridge processes remain in the ksu module launcher domain and use
# the root-owned /data/adb/teesimulator-rka/run/sockets Unix stream endpoint.
type teesimulator_rka_socket_dir file_type
type teesimulator_rka_socket file_type
type_transition ksu adb_data_file dir teesimulator_rka_socket_dir sockets
allow ksu ksu unix_stream_socket { create bind connect listen accept read write getattr getopt setopt shutdown }
allow ksu teesimulator_rka_socket_dir dir { search open read getattr write add_name remove_name setattr }
allow ksu teesimulator_rka_socket sock_file { create open read write getattr setattr unlink }
allow ksu unlabeled sock_file relabelfrom
allow ksu teesimulator_rka_socket sock_file relabelto
